[Unit]
Description=Export anonymous validator UTC buckets to InfluxDB
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/icinga-monitoring-main/validator-stats/export.py --config /opt/icinga-monitoring-main/validator-stats/config.json
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/icinga-monitoring-main/validator-stats
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
