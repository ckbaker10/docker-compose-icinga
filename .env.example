# Icinga Stack Environment Variables
# Copy this file to .env and customize the values as needed

# Icinga2 API User Password
ICINGAWEB_ICINGA2_API_USER_PASSWORD=icingaweb

# MySQL/MariaDB Passwords for Icinga Stack
ICINGADB_MYSQL_PASSWORD=icingadb
ICINGAWEB_MYSQL_PASSWORD=icingaweb
ICINGA_DIRECTOR_MYSQL_PASSWORD=director

# InfluxDB Configuration
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ADMIN_TOKEN=mytoken

# Grafana Configuration
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=grafanapassword